{
  "name": "forkip-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:css": "stylelint src/app/globals.css",
    "lint:tw": "eslint src --max-warnings=0",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check:structure": "node scripts/check-structure.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@coolicons/react": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tailwindcss": "4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
