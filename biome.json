{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!coverage",
      "!out",
      "!build",
      "!next-env.d.ts",
      "!public",
      "!playwright-report",
      "!test-results",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/*", "@/features/*/**"],
                    "message": "Import features through their public barrel (e.g. @/features/home) instead of deep imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/*", "@/app/*/*", "@/app/*/**"],
                    "message": "Features must not import from app routes. Keep features framework-agnostic and let routes import features."
                  },
                  {
                    "group": ["@/features/*/*", "@/features/*/**"],
                    "message": "Import other features through their public barrel (@/features/<name>) instead of deep imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/testing/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/*",
                      "@/features/*/*",
                      "@/app/*",
                      "@/app/*/*",
                      "@/features/*/**",
                      "@/app/*/**"
                    ],
                    "message": "Shared layers must not import from features or app routes. Move the dependency into a shared layer or invert it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
